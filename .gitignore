# Public source whitelist. Development reports, tests and packages stay private.
/*
!/.gitignore
!/.gitmodules
!/README.md
!/CHANGELOG.md
!/BUILDING-PUBLIC.md
!/LICENSE
!/COPYING
!/EXCEPTIONS.md
!/THIRD_PARTY.md
!/CMakeLists.txt
!/dependencies.lock.json
!/src/
/src/*
!/src/*.cpp
!/include/
/include/*
!/include/nbb/
/include/nbb/*
!/include/nbb/*.hpp
!/cmake/
/cmake/*
!/cmake/dependencies/
/cmake/dependencies/*
!/cmake/dependencies/*.cmake
!/tools/
/tools/*
!/tools/prepare_dependencies.py
!/licenses/
/licenses/*
!/licenses/*.txt
!/licenses/*.md
!/vendor/
/vendor/*
!/vendor/CommonLibSSE-NG
!/vendor/DirectXTK
!/vendor/json
!/vendor/rapidcsv
!/vendor/spdlog
!/vendor/zlib
**/__pycache__/
*.pyc
*.dll
*.pdb
*.lib
*.obj
*.exe
*.zip
